#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/* DANISH LAYOUT ALIASES FOR LINUX OS */
#define DK_AA   &kp LBKT
#define DK_AE   &kp SEMI
#define DK_OO   &kp APOS
#define DK_MINS &kp SLASH
#define DK_PLUS &kp MINUS
#define DK_EQL  &kp LS(N0)
#define DK_SLSH &kp LS(N7)
#define DK_ASTR &kp LS(BSLH)
#define DK_SQT  &kp BSLH
#define DK_DQOT &kp LS(N2)
#define DK_AMPR &kp LS(N6)
#define DK_PERC &kp LS(N5)
#define DK_C_RT &kp LS(RBKT)
#define DK_SCLN &kp LS(COMMA)
#define DK_COLN &kp LS(DOT)
#define DK_LPAR &kp LS(N8)
#define DK_RPAR &kp LS(N9)
#define DK_EXCL &kp LS(N1)
#define DK_AT   &kp RA(N2)
#define DK_HASH &kp LS(N3)
#define DK_PIPE &kp RA(EQUAL)
#define DK_TILD &kp RA(RBKT)
#define DK_LBRC &kp RA(N7)
#define DK_RBRC &kp RA(N0)
#define DK_LBKT &kp RA(N8)
#define DK_RBKT &kp RA(N9)
#define DK_QST  &kp LS(MINUS)
#define DK_BSLS &kp RA(NON_US_BSLH)
#define DK_GRV  &kp LS(EQUAL)
#define DK_DOLR &kp RA(N4)
#define DK_UNDS &kp LS(SLASH)

#define DK_LABK &kp NON_US_BSLH
#define DK_RABK &kp LS(NON_US_BSLH)
#define ALPHA 0
#define NAV   1
#define SYM   2
#define NUM   3
#define FUN   4
#define MEDIA 5


/ {
    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        ALPHA {
            bindings = <
&kp LSHFT         &kp B  &kp R  &kp L  &kp D                &kp J                                     DK_DQOT          &kp Y      &kp O      &kp U      &kp SEMI    &kp LBKT
&kp LEFT_CONTROL  &kp S  &kp N  &kp H  &kp T                &kp K                                     &kp W            &kp C      &kp A      &kp E      &kp I       DK_OO
                  &kp X  &kp M  &kp P  &kp V                &kp Z                                     &kp F            &kp G      &kp Q      &kp COMMA  &kp DOT
                                &mo MEDIA  &mt LEFT_GUI DELETE  &lt NAV SPACE  &lt SYM ENTER  &lt NUM ESC  &lt SYM BACKSPACE  &lt NAV TAB  &mo FUN
            >;
        };

        NAV {
            bindings = <
&kp LSHFT  &none  &none  &none          &none   &none                    &kp HOME        &kp PAGE_DOWN         &kp PG_UP             &kp END                &none  &none
&kp LCTRL  &none  &none  &none          &none   &none                    &kp LEFT        &kp DOWN              &kp UP                &kp RIGHT              &none  &none
           &none  &none  &none          &none   &none                    &kp HOME        &kp PAGE_DOWN         &kp PG_UP             &kp END                &kp INSERT
                         &trans         &trans  &trans  &trans   &trans  &trans          &trans                &trans
            >;
        };

        SYM {
            bindings = <
&trans  DK_LBRC     DK_AMPR     DK_ASTR     DK_LPAR     DK_RPAR                             &none   &none       &none   &none       &none  &none
&trans  DK_COLN     DK_DOLR     DK_PERC     DK_C_RT     DK_PLUS                             DK_QST  DK_SLSH     &none   DK_GRV      &none   &none
        DK_TILD     DK_EXCL     DK_AT       DK_HASH     DK_PIPE                             &none   DK_LABK     DK_RABK  DK_UNDS    DK_MINS
                                &trans      &trans      &trans           &trans    &trans   &trans    &trans    &trans
            >;
        };
        NUM {
            bindings = <
&trans  DK_LBKT  &kp N7  &kp N8  &kp N9  DK_RBKT                  &none  &none  &none  &none  &none  &none
&trans  DK_SCLN  &kp N4  &kp N5  &kp N6  DK_EQL                   &none  &none  &none  &none  &none  &none
        DK_SQT   &kp N1  &kp N2  &kp N3  DK_BSLS                  &none  &none  &none  &none  &none
                         &trans  &trans  &kp N0   &trans  &trans  &trans &trans &trans
            >;
        };
        FUN {
            bindings = <
&trans  &kp F12  &kp F7  &kp F8  &kp F9  &none                  &none  &none  &none  &none  &none  &none
&trans  &kp F11  &kp F4  &kp F5  &kp F6  &none                  &none  &none  &none  &none  &none  &bootloader
        &kp F10  &kp F1  &kp F2  &kp F3  &none                  &none  &none  &none  &none  &none
                         &trans  &trans  &trans   &trans  &trans  &trans &trans &trans
            >;
        };
        MEDIA {
            bindings = <
&none           &bt BT_CLR_ALL  &bt BT_CLR   &none       &none       &none                           &kp LC(Y)          &kp LC(V)           &kp LC(C)           &kp LC(X)   &kp LC(Z)   &none
&bootloader     &none           &none        &bt BT_PRV  &bt BT_NXT  &none                           &kp C_PREV         &kp C_VOLUME_DOWN   &kp C_VOLUME_UP     &kp C_NEXT  &kp F8   &none
                &none           &none        &none       &none       &none                           &none              &none               &none               &none       &none
                                             &trans      &trans      &trans       &trans     &trans  &kp C_PLAY_PAUSE   &kp C_STOP          &kp C_MUTE
            >;
        };
    };
};
